{
  "name": "dont-unplug-that-cloudflare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "npm run types:check && npm run test",
    "types:generate": "wrangler types --include-runtime false",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "config:check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-types": "5.20260808.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
