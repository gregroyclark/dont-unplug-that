{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dont-unplug-that-website",
  "account_id": "dd55e935d3b08e1d48766f81931ba8df",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "dontunplugthat.com",
      "custom_domain": true
    }
  ]
}
