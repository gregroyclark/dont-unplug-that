---
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import { components } from '../data/example';
import '@fontsource-variable/outfit';
import '../styles.css';
const selected = 0;
const expanded = false;
const showImpact = false;
const item = components[selected];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href="https://dontunplugthat.com/" />
    <meta name="theme-color" content="#1249dc" />
    <meta
      name="description"
      content="Make sense of unfamiliar equipment. Photograph a setup, understand its parts, and see what disconnecting something might affect."
    />
    <title>Don’t Unplug That — A clearer picture</title>
  </head>
  <body>
      <a class="skip-link" href="#main">
        Skip to content
      </a>
      <div class="page" id="top">
        <header class="header">
          <Brand />
          <nav aria-label="Main navigation">
            <a href="#how-it-works">How it works</a>
            <a href="#privacy">Privacy</a>
          </nav>
        </header>
        <main id="main">
          <section class="hero" aria-labelledby="hero-title">
            <h1 id="hero-title">
              From “what is this?”
              <br />
              to “now I get it.”
            </h1>
            <p class="hero-description">
              A clearer picture of the things around you.
              <br class="desktop-break" /> Photograph a setup and understand
              how it fits together.
            </p>
            <a class="button primary hero-cta" href="https://testflight.apple.com/join/pyJ7BHgR">
              Try the iOS beta
            </a>
            <figure class="setup-figure">
              <div class="setup-photo">
                <img
                  src="/images/living-room-audio.webp"
                  alt="A cream amplifier between two walnut speakers on an oak shelf, with plants and a pale blue wall."
                  width="2172"
                  height="724"
                  fetchpriority="high"
                />
                {components.map((component, index) => (
                  <button
                    data-component={index}
                    class={`annotation ${selected === index ? "selected" : ""}`}
                    style={{ left: `${component.x}%`, top: `${component.y}%` }}
                    aria-label={`Explore ${component.name.toLowerCase()}`}
                    aria-pressed={selected === index}
                    aria-controls="example-details"
                  >
                    <span>{index + 1}</span>
                  </button>
                ))}
              </div>
              <figcaption>
                <button
                  class="caption-button" id="example-caption"
                  aria-expanded={expanded}
                  aria-controls="example-details"
                >
                  <span class="number" data-number>{selected + 1}</span>
                  <strong data-name>{item.name}</strong>
                  <span class="caption-dot" aria-hidden="true">
                    ·
                  </span>
                  <span class="caption-summary" data-summary>{item.summary}</span>
                  <Icon name="caret-down"
                    size={20}
                    class={expanded ? "rotated" : ""}
                    aria-hidden="true"
                  />
                </button>
                <span class="example-label">Interactive example</span>
              </figcaption>
            </figure>
            <div
              id="example-details"
              hidden={!expanded}
              class="example-details"
            >
              <div class="detail-heading">
                <div>
                  <span class="eyebrow">Example guide</span>
                  <h2 data-name>{item.name}</h2>
                </div>
                <button
                  class="icon-button"
                  aria-label="Close example details"
                >
                  <Icon name="x" size={22} />
                </button>
              </div>
              <div class="detail-columns">
                <div>
                  <h3>What it likely does</h3>
                  <p data-purpose>{item.purpose}</p>
                </div>
                <div>
                  <h3>
                    <Icon name="eye" size={19} aria-hidden="true" /> What we can tell
                  </h3>
                  <p data-evidence>{item.evidence}</p>
                </div>
              </div>
              <button
                class="button primary"
                aria-expanded={showImpact}
                aria-controls="unplugging-impact" id="impact-toggle"
              >
                <span data-impact-label>What if I unplug it?</span>
                <Icon name="caret-down"
                  size={18}
                  class={showImpact ? "rotated" : ""}
                  aria-hidden="true"
                />
              </button>
              <p
                id="unplugging-impact"
                hidden={!showImpact}
                class="impact"
                role="status"
              >
                {item.impact}
              </p>
              <p class="safety-note">
                <Icon name="shield-check" size={21} aria-hidden="true" />
                <span>
                  A photo cannot confirm it is safe to disconnect. Stop if
                  anything is hot, damaged, wet, or sparking, and ask a
                  qualified technician.
                </span>
              </p>
              <p class="demo-note">
                Illustrative example using a generated photo, not a live
                analysis.
              </p>
            </div>
            <a href="#privacy" class="privacy-link">
              <Icon name="lock-key" size={22} aria-hidden="true" />
              Photo analysis stays on your device.
            </a>
          </section>
          <section
            id="how-it-works"
            class="how-section"
            aria-labelledby="how-title"
          >
            <div class="section-intro">
              <span class="eyebrow">A little less guesswork</span>
              <h2 id="how-title">Start with what you see.</h2>
              <p>
                From the living room to the equipment cupboard, a few photos can
                make an unfamiliar setup easier to understand.
              </p>
            </div>
            <div class="how-layout">
              <div class="welcome-photo">
                <img
                  src="/images/welcome-setup.jpg"
                  alt="A fabric speaker, a green plant and a coiled cable against a light blue background."
                  width="1200"
                  height="960"
                  loading="lazy"
                />
                <span>One photo is a good place to start.</span>
              </div>
              <ol class="steps">
                <li>
                  <Icon name="camera" size={28} aria-hidden="true" />
                  <div>
                    <h3>Take a photo.</h3>
                    <p>
                      Capture the whole setup. Add up to three angles to show
                      labels and both ends of important cables.
                    </p>
                  </div>
                </li>
                <li>
                  <Icon name="eye" size={28} aria-hidden="true" />
                  <div>
                    <h3>Get to know the parts.</h3>
                    <p>
                      Tap a numbered pin to see what an item likely does, with a
                      clear distinction between what’s visible and what’s
                      inferred.
                    </p>
                  </div>
                </li>
                <li>
                  <Icon name="plug" size={28} aria-hidden="true" />
                  <div>
                    <h3>Understand what could change.</h3>
                    <p>
                      See what disconnecting an item might affect, where there’s
                      uncertainty, and when to ask for help.
                    </p>
                  </div>
                </li>
              </ol>
            </div>
            <a class="text-link" href="#top" data-try-example>
              Try the example above
              <Icon name="arrow-right" size={20} aria-hidden="true" />
            </a>
          </section>
          <section
            id="privacy"
            class="privacy-section"
            aria-labelledby="privacy-title"
          >
            <Icon name="lock-key"
              class="privacy-icon"
              size={38}
              weight="light"
              aria-hidden="true"
            />
            <div>
              <span class="eyebrow">Your space. Your photos.</span>
              <h2 id="privacy-title">Clarity, with a little privacy.</h2>
              <p>
                The app analyzes photos on your device. Your guides stay there
                too, unless you choose to turn on sync.
              </p>
              <p>
                Optional sync stores private, resized photo copies with photo
                metadata removed, along with your guides. Sync is not end-to-end
                encrypted.
              </p>
              <p class="muted">
                On-device analysis requires a supported device and model.
                Availability varies by platform.
              </p>
            </div>
          </section>
        </main>
        <footer>
          <Brand />
          <span>A clearer picture. A more considered next step.</span>
          <a href="#top">
            Back to top
            <Icon name="arrow-right" size={16} aria-hidden="true" />
          </a>
        </footer>
      </div>
    <script>
      import '../scripts/example';
    </script>
  </body>
</html>
